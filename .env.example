# Copy to .env (cp .env.example .env). Every app in the repo reads this one file.
# Leave a key empty to run without it: no OpenAI key -> offline demo model,
# no SerpAPI key -> the MCP server returns clearly labeled mock search results.

# ---------------------------------------------------------------- OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# gpt-5 accepts minimal | low | medium | high. gpt-5.1 and later use none instead of minimal.
OPENAI_REASONING_EFFORT=minimal
OPENAI_VERBOSITY=low
OPENAI_MAX_OUTPUT_TOKENS=1000
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional OpenAI-compatible gateway:
# OPENAI_BASE_URL=

# ------------------------------------------------- SerpAPI (MCP server)
SERPAPI_API_KEY=
SERPAPI_TIMEOUT_MS=5000
SEARCH_CACHE_TTL_SECONDS=600

# ------------------------------------------------------------ MCP server
MCP_HOST=127.0.0.1
MCP_PORT=8787
# Required when MCP_HOST=0.0.0.0 (DNS-rebinding protection), e.g. mcp-search,localhost
# MCP_ALLOWED_HOSTS=

# ------------------------------------------------------------ API server
HOST=127.0.0.1
PORT=3000
MCP_SERVER_URL=http://127.0.0.1:8787/mcp
WEB_SEARCH_ENABLED=true
# The API stops waiting for web results after this long and answers from documents.
WEB_SEARCH_TIMEOUT_MS=3000
WEB_SEARCH_RESULTS=5

RAG_TOP_K=5
# Relevance threshold (cosine similarity) for "the documents answer this".
# Defaults: 0.30 with OpenAI embeddings, 0.12 with the offline embeddings.
# RAG_MIN_SCORE=0.3
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
HISTORY_TURNS=6
MAX_UPLOAD_MB=20

CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Public no-key sample preview (disables uploaded data, voice and web search).
PUBLIC_DEMO=false
# Hosted online demo (use scripts/start-render.mjs with runtime keys; not for private uploads).
PUBLIC_LIVE_DEMO=false
